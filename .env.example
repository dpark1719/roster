# Postgres connection string (Neon or Supabase free tier)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared admin password for /admin
ADMIN_PASSWORD=change-me

# Random 32+ char secret used to sign the visitor_id and admin session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
